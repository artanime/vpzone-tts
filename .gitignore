# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/

# Entorno virtual
.venv/
venv/

# Datos generados en tiempo de ejecución (solo en la raíz; NO toca tts/audio/)
/logs/
/temp/
/audio/
*.log

# Configuración local (NO se debe subir)
# Usa config/config.example.json como plantilla.
config/config.json

# Secretos: variables de entorno y tokens generados por la app.
# NUNCA deben subirse al repositorio.
.env
.env.*
!.env.example
config/secrets.json

# Modelos de voz descargados (pesados; se descargan aparte)
voices/**/*.onnx
voices/**/*.onnx.json

# Sistema operativo / editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
