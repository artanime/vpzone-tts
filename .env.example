# Credenciales de VPZone TTS
#
# Este archivo NO se sube a git (esta en .gitignore).
# Copia .env.example a .env y rellena tus valores.
#
# Los access_token / refresh_token se generan con el boton "Cuenta Woupi"
# y se guardan solos en config/secrets.json. Pega aqui valores solo si los
# quieres cargar manualmente la primera vez.

# API de VPZone (Bearer). Vacio si no la usas.
VPZONE_API_KEY=

# Tokens de Woupi (wpa_... / wpr_...). Opcional: normalmente los gestiona la app.
WOUPI_ACCESS_TOKEN=
WOUPI_REFRESH_TOKEN=
